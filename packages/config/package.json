{
  "name": "@zerolance/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZeroLance shared config — networks, addresses, ABIs, EIP-712, crypto, 0G Storage, env, auth.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage/0g": {
      "types": "./dist/storage/0g.d.ts",
      "default": "./dist/storage/0g.js"
    },
    "./middleware/auth": {
      "types": "./dist/middleware/auth.d.ts",
      "default": "./dist/middleware/auth.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./env-schema": {
      "types": "./dist/env-schema.d.ts",
      "default": "./dist/env-schema.js"
    },
    "./addresses": {
      "types": "./dist/addresses.d.ts",
      "default": "./dist/addresses.js"
    },
    "./networks": {
      "types": "./dist/networks.d.ts",
      "default": "./dist/networks.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./eip712": {
      "types": "./dist/eip712.d.ts",
      "default": "./dist/eip712.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./dist/process.js"
    },
    "./crypto/aes-gcm": {
      "types": "./dist/crypto/aes-gcm.d.ts",
      "default": "./dist/crypto/aes-gcm.js"
    },
    "./crypto/keys": {
      "types": "./dist/crypto/keys.d.ts",
      "default": "./dist/crypto/keys.js"
    },
    "./abis": {
      "types": "./dist/abis/index.d.ts",
      "default": "./dist/abis/index.js"
    },
    "./types/hex": {
      "types": "./dist/types/hex.d.ts",
      "default": "./dist/types/hex.js"
    },
    "./types/contract": {
      "types": "./dist/types/contract.d.ts",
      "default": "./dist/types/contract.js"
    },
    "./types/index": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./types/verdict": {
      "types": "./dist/types/verdict.d.ts",
      "default": "./dist/types/verdict.js"
    },
    "./types/task": {
      "types": "./dist/types/task.d.ts",
      "default": "./dist/types/task.js"
    },
    "./types/dispute": {
      "types": "./dist/types/dispute.d.ts",
      "default": "./dist/types/dispute.js"
    },
    "./types/reputation": {
      "types": "./dist/types/reputation.d.ts",
      "default": "./dist/types/reputation.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test $(find src test -name '*.test.ts' 2>/dev/null | sort)"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.11",
    "eciesjs": "^0.4.18",
    "ethereum-cryptography": "^2.2.1",
    "ethers": "^6.16.0",
    "viem": "^2.21.45",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
