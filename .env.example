# ── ZeroLance protocol ───────────────────────────────────────────────────
# 0G Chain
ZERO_CHAIN_ID=16661
ZERO_EVM_RPC=https://evmrpc.0g.ai
ZERO_STORAGE_RPC=https://indexer-storage-turbo.0g.ai

# ── Deployed contract addresses (filled after `pnpm deploy:galileo`) ─────
ZERO_MOCK_USDC_ADDRESS=
ZERO_TOKEN_ADDRESS=
ZERO_TEE_VERIFIER_ADDRESS=
ZERO_TASK_REGISTRY_ADDRESS=
ZERO_ESCROW_VAULT_ADDRESS=
ZERO_ARBITRATION_ADDRESS=
ZERO_REPUTATION_NFT_ADDRESS=

# ── Wave funding contracts (deploy ZeroLanceWaveProgram/Issue/Buildathon) ─
ZERO_WAVE_PROGRAM_ADDRESS=
ZERO_WAVE_ISSUE_ADDRESS=
ZERO_WAVE_BUILDATHON_ADDRESS=

# ── Backend ──────────────────────────────────────────────────────────────
ZERO_PORT=3000
ZERO_BIND=0.0.0.0
DEPLOYER_PK=
ZERO_RUNTIME_SIGNER_PK=
ZERO_OPERATOR_PK=
ZERO_API_KEY=
ZERO_CLIENT_API_KEY=
ZERO_DISABLE_AUTH=true
ZERO_RATE_LIMIT_MAX=200
INDEXER_POLL_WINDOW_BLOCKS=500
INDEXER_START_BLOCK=0
ZERO_DATA_DIR=

# ── DA publisher (anchors events as 0G Storage blobs) ─────────────────────
ZERO_DA_MAX_BATCH_EVENTS=50
ZERO_DA_FLUSH_INTERVAL_MS=5000

# ── Oracle (TEE signer) ──────────────────────────────────────────────────
ZERO_ORACLE_URL=http://localhost:8787
ZERO_ORACLE_PORT=8787
ZERO_TEE_SIGNER_PK=
ZERO_ALLOW_CLEARTEXT_DEK=false

# ── AI / Compute ─────────────────────────────────────────────────────────
ZERO_COMPUTE_API_KEY=
ZERO_COMPUTE_BASE_URL=
ZERO_COMPUTE_MODEL=meta-llama/Llama-3.1-70B-Instruct
OG_COMPUTE_API_KEY=
ZERO_COMPUTE_DIRECT_KEY=
ZERO_COMPUTE_DIRECT_URL=

# ── GitHub integration ──────────────────────────────────────────────────
ZERO_GITHUB_TOKEN=
ZERO_GITHUB_OAUTH_CLIENT_ID=
ZERO_GITHUB_OAUTH_CLIENT_SECRET=
ZERO_GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/v1/github/auth/callback
ZERO_GITHUB_WEBHOOK_SECRET=
ZERO_SANDBOX_IMAGE=node:22-alpine
ZERO_VERIFICATION_TIMEOUT_MS=300000

# ── Frontend / Sentry ────────────────────────────────────────────────────
ZERO_FRONTEND_URL=http://localhost:5173
ZERO_SENTRY_DSN=
