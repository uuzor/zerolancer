{
  "$schema": "https://vercel.com/vercel-project-config.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @zerolance/config build && pnpm --filter @zerolance/frontend build",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "http://localhost:3000/v1/:path*" },
    { "source": "/health", "destination": "http://localhost:3000/health" }
  ]
}
