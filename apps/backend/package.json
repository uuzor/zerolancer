{
  "name": "@zerolance/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZeroLance orchestration engine + HTTP/WS server — tasks, escrow, AI verification, GitHub runner, disputes.",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "prestart": "pnpm build",
    "dev": "node --import tsx src/index.ts",
    "test": "node --import tsx --test $(find src test -name '*.test.ts' 2>/dev/null | sort)",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zerolance/config": "workspace:*",
    "@zerolance/shared": "workspace:*",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "ethers": "^6.16.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "openai": "^4.104.0",
    "viem": "^2.21.45",
    "@sentry/node": "^10.62.0",
    "ws": "^8.18.0",
    "lru-cache": "^11.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
