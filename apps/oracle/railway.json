{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter @zerolance/config build && pnpm --filter @zerolance/oracle build"
  },
  "deploy": {
    "startCommand": "node apps/oracle/dist/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicy": "ON_FAILURE"
  },
  "watchPatterns": ["apps/oracle/**", "packages/config/**"]
}
